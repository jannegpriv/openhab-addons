	<channel-type id="sigenergy-inv-running-state">
		<item-type>String</item-type>
		<label>Inverter Running State</label>
		<description>Operating state of the inverter (register 30578, Appendix 1). Unknown values are shown as "Unknown (n)".</description>
		<tags>
			<tag>Status</tag>
		</tags>
		<state readOnly="true">
			<options>
				<option value="STANDBY">Standby</option>
				<option value="RUNNING">Running</option>
				<option value="FAULT">Fault</option>
				<option value="SHUTDOWN">Shutdown</option>
				<option value="ENVIRONMENTAL_ABNORMALITY">Environmental abnormality</option>
			</options>
		</state>
	</channel-type>
	<channel-type id="sigenergy-inv-alarm-active">
		<item-type>Switch</item-type>
		<label>Inverter Alarm Active</label>
		<description>ON if any bit in alarm registers 30605-30609 is set.</description>
		<tags>
			<tag>Alarm</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="sigenergy-inv-alarm-mask-1" advanced="true">
