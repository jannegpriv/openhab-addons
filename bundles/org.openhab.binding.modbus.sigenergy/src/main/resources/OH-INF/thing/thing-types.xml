	<thing-type id="sigenergy-plant">
		<supported-bridge-type-refs>
			<bridge-type-ref id="serial"/>
			<bridge-type-ref id="tcp"/>
		</supported-bridge-type-refs>

		<label>Sigenergy Plant</label>
		<description>Plant-level monitoring of a Sigenergy SigenStor system via Modbus (read-only).</description>
		<category>Inverter</category>
		<channel-groups>
			<channel-group id="overview" typeId="sigenergy-overview"/>
			<channel-group id="grid" typeId="sigenergy-grid"/>
			<channel-group id="battery" typeId="sigenergy-battery"/>
			<channel-group id="energy" typeId="sigenergy-energy"/>
		</channel-groups>
		<config-description-ref uri="thing-type:sigenergy:plant"/>
	</thing-type>

	<thing-type id="sigenergy-evac">
		<supported-bridge-type-refs>
			<bridge-type-ref id="serial"/>
			<bridge-type-ref id="tcp"/>
		</supported-bridge-type-refs>

		<label>Sigen EV AC Charger</label>
		<description>Read-only monitoring of a Sigen EVAC charger through the plant's Modbus TCP endpoint. The charger's
			own
			Modbus unit ID (1-246) must be configured in the mySigen app.</description>
		<category>WallSwitch</category>
		<channel-groups>
			<channel-group id="status" typeId="sigenergy-evac-status"/>
			<channel-group id="charging" typeId="sigenergy-evac-charging"/>
			<channel-group id="ratings" typeId="sigenergy-evac-ratings"/>
		</channel-groups>
		<config-description-ref uri="thing-type:sigenergy:evac"/>
	</thing-type>

	<thing-type id="sigenergy-inverter">
		<supported-bridge-type-refs>
			<bridge-type-ref id="serial"/>
			<bridge-type-ref id="tcp"/>
		</supported-bridge-type-refs>

		<label>Sigenergy Hybrid Inverter</label>
		<description>Read-only monitoring of a Sigenergy hybrid inverter, including per-string PV data. Uses the
			inverter's own
			Modbus unit ID (1-246, configured in mySigen).</description>
		<category>Inverter</category>
		<channel-groups>
			<channel-group id="status" typeId="sigenergy-inv-status"/>
			<channel-group id="power" typeId="sigenergy-inv-power"/>
			<channel-group id="strings" typeId="sigenergy-inv-strings"/>
			<channel-group id="phases" typeId="sigenergy-inv-phases"/>
			<channel-group id="battery" typeId="sigenergy-inv-battery"/>
			<channel-group id="energy" typeId="sigenergy-inv-energy"/>
		</channel-groups>
		<config-description-ref uri="thing-type:sigenergy:inverter"/>
	</thing-type>

